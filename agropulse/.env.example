REDIS_URL=redis://localhost:6379/0
JWT_SECRET=path/to/private.pem
JWT_PUBLIC=path/to/public.pem
WHATSAPP_TOKEN=EAAxxxxx
WHATSAPP_PHONE_ID=123456789
WHATSAPP_VERIFY_TOKEN=agropulse-dev
AWS_ACCESS_KEY=AKIA...
AWS_SECRET_KEY=...
S3_BUCKET=agropulse-data
SMS_API_KEY=atk_...
SMS_USERNAME=sandbox
ENVIRONMENT=development
MAINTENANCE_MODE=false

# Cle privee RSA (PEM sur une ligne, \n) — garder stable entre les deploiements
# pour ne pas invalider les sessions. Generee avec :
#   python -c "from cryptography.hazmat.primitives import serialization as s; from cryptography.hazmat.primitives.asymmetric import rsa; print(rsa.generate_private_key(public_exponent=65537,key_size=2048).private_bytes(s.Encoding.PEM,s.PrivateFormat.PKCS8,s.NoEncryption()).decode().replace(chr(10),'\\n'))"
JWT_PRIVATE_KEY=
PII_HASH_SECRET=
# Cle de debogage : permet de lire l'OTP en l'absence de fournisseur SMS.
# A DESACTIVER (laisser vide) quand le SMS reel est configure.
DEBUG_OTP_KEY=
